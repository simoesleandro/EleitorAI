# EleitorAI — CI environment template
# This file is COMMITTED to the repo (unlike .env) so CI environments
# have a documented, predictable baseline. ALL values here are FAKE.
# Never put real secrets in this file.
#
# CI sets these as environment variables to override the .env path.
# Tests assert that no real values leak into logs/code from this file.

# =============================================================================
# LLM — Gemini (fake value for CI; tests mock anyway)
# =============================================================================
GEMINI_API_KEY=ci-fake-gemini-key-do-not-use-in-production-1234567890

# =============================================================================
# Telegram — fake bot + account creds for CI
# =============================================================================
TELEGRAM_BOT_TOKEN=0000000000:CIFakeBotTokenForTestingOnly_ABCDEFGHIJ
TELEGRAM_CHAT_ID=0000000000
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=00000000000000000000000000000000

# =============================================================================
# App — fixed CI values; never real
# =============================================================================
ADMIN_PASS=ci-fake-admin-pass-not-for-production
SECRET_KEY=ci-fake-flask-secret-key-hex-abc123def456789

# =============================================================================
# Database — use temp dir in CI
# =============================================================================
DB_PATH=:memory:

# =============================================================================
# Langfuse — fake values for CI (skipped if blank)
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
